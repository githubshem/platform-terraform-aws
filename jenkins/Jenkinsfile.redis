/**
 * Jenkinsfile.redis
 *
 * Jenkins Declarative Pipeline - Terraform Redis (ElastiCache)
 *
 * Supported resource path:
 *   Terraform/10-data/elasticache/environments/{env}/{cluster}/
 *
 * Cluster names vary by environment:
 *   test → selene | hera | persephone | gaia
 *   prod    → selene | hera | persephone |
 *                gaia
 */

pipeline {
    agent any

    parameters {
        string(
            name: 'GIT_REPO_URL',
            defaultValue: 'https://git.example.com/example-org/platform-terraform-aws.git',
            description: 'plat-terraform repository URL'
        )
        string(
            name: 'GIT_BRANCH',
            defaultValue: 'main',
            description: 'Branch to check out'
        )
        choice(
            name: 'TERRAFORM_ENV',
            choices: ['test', 'prod'],
            description: 'Target environment'
        )
        booleanParam(
            name: 'RUN_APPLY',
            defaultValue: false,
            description: 'Tick to enable Approval Gate + Apply (leave unticked for plan-only runs)'
        )
    }

    tools { terraform 'terraform-1.15.5' }

    environment {
        AWS_CRED_ID = 'AWS_SESSION_TOKEN'
        GIT_CRED_ID = 'git-grafana'
    }

    stages {

        stage('Checkout Code') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "${params.GIT_BRANCH}"]],
                    userRemoteConfigs: [[
                        url: "${params.GIT_REPO_URL}",
                        credentialsId: "${env.GIT_CRED_ID}"
                    ]]
                ])
            }
        }

        stage('Resolve Terraform Path') {
            steps {
                script {
                    def clustersByEnv = [
                        'test': [
                            'selene',
                            'hera',
                            'persephone',
                            'gaia'
                        ],
                        prod: [
                            'selene',
                            'hera',
                            'persephone',
                            'gaia'
                        ]
                    ]

                    if (!clustersByEnv.containsKey(params.TERRAFORM_ENV)) {
                        error("Invalid TERRAFORM_ENV '${params.TERRAFORM_ENV}'. Allowed: ${clustersByEnv.keySet().join(', ')}")
                    }

                    def selectedCluster = params.CLUSTER_NAME?.trim()
                    if (!selectedCluster) {
                        error("CLUSTER_NAME is required.")
                    }

                    def allowedClusters = clustersByEnv[params.TERRAFORM_ENV]
                    if (!(selectedCluster in allowedClusters)) {
                        error("Invalid CLUSTER_NAME '${selectedCluster}' for env '${params.TERRAFORM_ENV}'. Allowed: ${allowedClusters.join(', ')}")
                    }

                    env.BASE_PATH = [
                        "Terraform/10-data/elasticache/environments",
                        params.TERRAFORM_ENV,
                        selectedCluster
                    ].join('/')

                    echo "Resolved BASE_PATH: ${env.BASE_PATH}"
                }
            }
        }

        stage('Quality Gates (pre-init)') {
            steps {
                script {
                    def tf = load 'jenkins/shared/terraform_common.groovy'
                    tf.runQualityGatesPreInit(env.BASE_PATH)
                }
            }
        }

        stage('Terraform Init') {
            steps {
                script {
                    def tf = load 'jenkins/shared/terraform_common.groovy'
                    tf.tfInit(env.BASE_PATH, env.AWS_CRED_ID)
                }
            }
        }

        stage('Quality Gates (post-init)') {
            steps {
                script {
                    def tf = load 'jenkins/shared/terraform_common.groovy'
                    tf.runQualityGatesPostInit(env.BASE_PATH, env.AWS_CRED_ID)
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                script {
                    def tf = load 'jenkins/shared/terraform_common.groovy'
                    tf.tfPlan(env.BASE_PATH, env.AWS_CRED_ID)
                }
            }
            post {
                always {
                    script {
                        def tf = load 'jenkins/shared/terraform_common.groovy'
                        tf.archivePlanArtifacts(env.BASE_PATH)
                    }
                }
            }
        }

        stage('Policy Check') {
            steps {
                script {
                    def tf = load 'jenkins/shared/terraform_common.groovy'
                    tf.policyCheck(env.BASE_PATH)
                }
            }
        }

        stage('Approval Gate') {
            when {
                expression { return params.RUN_APPLY == true }
            }
            steps {
                script {
                    def tf = load 'jenkins/shared/terraform_common.groovy'
                    tf.approvalGate(
                        "Review the Redis plan for cluster '${params.CLUSTER_NAME}' " +
                        "(env: ${params.TERRAFORM_ENV}). Check plan_summary.txt before approving.",
                        30
                    )
                }
            }
        }

        stage('State Snapshot') {
            when {
                expression { return params.RUN_APPLY == true }
            }
            steps {
                script {
                    def tf = load 'jenkins/shared/terraform_common.groovy'
                    tf.snapshotStateBeforeApply(env.BASE_PATH, "${env.BUILD_NUMBER}", env.AWS_CRED_ID)
                }
            }
        }

        stage('Terraform Apply') {
            when {
                expression { return params.RUN_APPLY == true }
            }
            steps {
                script {
                    def tf = load 'jenkins/shared/terraform_common.groovy'
                    tf.tfApply(env.BASE_PATH, env.AWS_CRED_ID)
                }
            }
        }

    }

    post {
        success {
            echo "✅ Redis pipeline completed for ${params.CLUSTER_NAME} (${params.TERRAFORM_ENV})"
        }
        failure {
            echo "❌ Redis pipeline failed for ${params.CLUSTER_NAME} (${params.TERRAFORM_ENV})"
        }
        aborted {
            echo "⏹ Redis pipeline aborted - Apply was not executed."
        }
    }
}
